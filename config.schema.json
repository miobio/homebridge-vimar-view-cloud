{
  "pluginAlias": "VimarViewCloud",
  "pluginType": "platform",
  "singular": false,
  "headerDisplay": "Connects Vimar View devices (Wi-Fi thermostat 02912 and View Wireless lights, dimmers and shutters) to HomeKit through the Vimar cloud. **Unofficial** plugin: requires an internet connection.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Vimar View",
        "required": true
      },
      "username": {
        "title": "MyVimar e-mail",
        "type": "string",
        "format": "email",
        "required": true
      },
      "password": {
        "title": "MyVimar password",
        "type": "string",
        "required": true,
        "x-schema-form": {
          "type": "password"
        }
      },
      "duid": {
        "title": "Device DUIDs",
        "type": "string",
        "required": true,
        "placeholder": "013009FAL00087, 013009FAL00117, 013009FAL00123",
        "description": "View app → Settings → System info → \"Gateway devices\": the code under each device (e.g. STW 013009FAL00087). Separate multiple DUIDs with commas. Do NOT use the plant UID."
      },
      "enableCooling": {
        "title": "Enable cooling",
        "type": "boolean",
        "default": false,
        "description": "Show the 'Cool' mode on thermostats (only if your system supports it)."
      },
      "onMode": {
        "title": "Mode used when turning a thermostat on from HomeKit",
        "type": "string",
        "default": "Auto",
        "oneOf": [
          {
            "title": "Follow the weekly schedule (Auto)",
            "enum": [
              "Auto"
            ]
          },
          {
            "title": "Permanent manual",
            "enum": [
              "Manual"
            ]
          }
        ]
      },
      "scheduleSwitch": {
        "title": "\"Schedule\" switch",
        "type": "boolean",
        "default": true,
        "description": "Adds a switch per thermostat: on = follow the weekly schedule, off = permanent manual."
      },
      "scheduleSwitchName": {
        "title": "Schedule switch label",
        "type": "string",
        "default": "Schedule",
        "placeholder": "Schedule",
        "description": "Appended to the thermostat name (e.g. \"Living Schedule\")."
      },
      "minTemperature": {
        "title": "Minimum setpoint (°C)",
        "type": "number",
        "default": 5,
        "minimum": 0,
        "maximum": 20
      },
      "maxTemperature": {
        "title": "Maximum setpoint (°C)",
        "type": "number",
        "default": 35,
        "minimum": 20,
        "maximum": 40
      },
      "deviceTypes": {
        "title": "Device types to expose",
        "type": "array",
        "uniqueItems": true,
        "default": [
          "thermostat",
          "light",
          "dimmer",
          "shutter",
          "switch"
        ],
        "items": {
          "type": "string",
          "oneOf": [
            {
              "title": "Thermostats",
              "enum": [
                "thermostat"
              ]
            },
            {
              "title": "On/off lights",
              "enum": [
                "light"
              ]
            },
            {
              "title": "Dimmers",
              "enum": [
                "dimmer"
              ]
            },
            {
              "title": "Shutters",
              "enum": [
                "shutter"
              ]
            },
            {
              "title": "On/off automations",
              "enum": [
                "switch"
              ]
            },
            {
              "title": "Scenes",
              "enum": [
                "scene"
              ]
            }
          ]
        }
      },
      "exclude": {
        "title": "Exclude (name or idsf)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "debug": {
        "title": "Debug",
        "type": "boolean",
        "default": false,
        "description": "Logs every function found and the WebSocket traffic (tokens, e-mail and MAC addresses are masked). For troubleshooting only."
      }
    }
  },
  "layout": [
    "name",
    "username",
    "password",
    "duid",
    {
      "type": "fieldset",
      "title": "Thermostat",
      "expandable": true,
      "items": [
        "onMode",
        "scheduleSwitch",
        "scheduleSwitchName",
        "enableCooling",
        "minTemperature",
        "maxTemperature"
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "items": [
        "deviceTypes",
        "exclude",
        "debug"
      ]
    }
  ]
}
